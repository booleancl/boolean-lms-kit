#!/usr/bin/env sh
# Levanta Vite (HMR) y Jekyll (livereload) juntos con overmind (requiere tmux).
# Conectarse a un proceso: `bundle exec overmind connect jekyll`. Reiniciar: `bundle exec overmind restart vite`.
cd "$(dirname "$0")/.." || exit 1

if ! command -v tmux >/dev/null 2>&1; then
  echo "overmind necesita tmux; instálalo primero (p. ej. apt install tmux / brew install tmux)." >&2
  exit 1
fi

exec bundle exec overmind start -f Procfile.dev "$@"
